{
  "openapi": "3.0.4",
  "info": {
    "title": "Amigurumemi API",
    "description": "Detailed API documentation for an amigurumi project, pattern, and yarn management system.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://localhost:7233/"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AuthTokenRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "description": "The username for logging in"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 100,
            "description": "The user's password"
          }
        },
        "additionalProperties": false
      },
      "AuthTokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true,
            "description": "JWT access token"
          },
          "expiration": {
            "type": "string",
            "format": "date-time",
            "description": "Token expiration date and time"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DifficultyLevel": {
        "type": "integer",
        "format": "int32",
        "enum": [
          1,
          2,
          3
        ],
        "description": "Difficulty level: 1 = Easy, 2 = Medium, 3 = Hard"
      },
      "PatternRequest": {
        "type": "object",
        "required": [
          "name",
          "difficulty",
          "category",
          "price",
          "isFree",
          "stitchCount"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "difficulty": {
            "$ref": "#/components/schemas/DifficultyLevel"
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "isFree": {
            "type": "boolean"
          },
          "stitchCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        },
        "additionalProperties": false
      },
      "PatternResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "difficulty": {
            "$ref": "#/components/schemas/DifficultyLevel"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "isFree": {
            "type": "boolean"
          },
          "stitchCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProjectStatus": {
        "type": "integer",
        "enum": [
          0,
          1,
          2
        ],
        "description": "Project status: 0 = NotStarted, 1 = InProgress, 2 = Completed"
      },
      "ProjectRequest": {
        "type": "object",
        "required": [
          "name",
          "patternId",
          "userId",
          "status",
          "progress",
          "startDate"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "patternId": {
            "type": "integer",
            "minimum": 1
          },
          "userId": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "estimatedCost": {
            "type": "number",
            "minimum": 0
          },
          "isFavorite": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ProjectResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "progress": {
            "type": "integer"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "finishDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "estimatedCost": {
            "type": "number"
          },
          "isFavorite": {
            "type": "boolean"
          },
          "userId": {
            "type": "integer"
          },
          "patternId": {
            "type": "integer"
          }
        }
      },
      "UserRequest": {
        "type": "object",
        "required": [
          "username",
          "email",
          "password",
          "firstName",
          "lastName"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 100
          },
          "firstName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "lastName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          }
        },
        "additionalProperties": false
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "registrationDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "YarnRequest": {
        "type": "object",
        "required": [
          "name",
          "brand",
          "color",
          "weight",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "brand": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "color": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "weight": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1000
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "projectId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "YarnResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "projectId": {
            "type": "integer"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login. Returns a JWT token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              }
            }
          }
        }
      }
    },
