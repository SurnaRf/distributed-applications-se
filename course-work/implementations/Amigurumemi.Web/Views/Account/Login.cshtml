@using Amigurumemi.Contracts.Messaging.Requests.Auth
@model AuthTokenRequest

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow border-0 rounded-3">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">🧶 Amigurumemi</h2>
                    <p class="text-muted">Welcome back! Please login.</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control" id="floatingUser" placeholder="Username" />
                        <label asp-for="Username">Username</label>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Password" />
                        <label asp-for="Password">Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg rounded-pill shadow-sm mt-2">Sign In</button>
                </form>

                <div class="text-center mt-4">
                    <p class="mb-0 text-muted small">Don't have an account?</p>
                    <a asp-action="Register" class="text-decoration-none fw-bold text-success">Create an account here</a>
                </div>
            </div>
        </div>
    </div>
</div>