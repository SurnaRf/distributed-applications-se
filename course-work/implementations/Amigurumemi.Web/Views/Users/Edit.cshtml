@using Amigurumemi.Contracts.Messaging.Requests.Users
@model UserRequest

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4">Edit User Account</h2>

    <form method="post" class="card p-4 shadow-sm border-0">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label fw-bold">Username</label>
            <input asp-for="Username" class="form-control bg-light" readonly />
            <div class="form-text small text-muted">Username cannot be changed.</div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label fw-bold">Reset Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Enter new password if change required" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-2">
            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
            <button type="submit" class="btn btn-warning px-4 fw-bold">Save Changes</button>
        </div>
    </form>
</div>