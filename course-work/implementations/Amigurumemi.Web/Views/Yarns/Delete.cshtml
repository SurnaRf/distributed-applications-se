@using Amigurumemi.Contracts.Messaging.Responses.Yarns
@model YarnResponse

<div class="container mt-5" style="max-width: 550px;">
    <div class="card border-danger shadow-sm">
        
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Delete Yarn</h4>
        </div>
        
        <div class="card-body py-4">
            <p class="fs-5 text-center mb-4">Are you sure you want to delete this yarn from your inventory?</p>
            
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted">Name:</span>
                    <strong class="text-danger">@Model.Name</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted">Brand:</span>
                    <span>@Model.Brand</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted">Color:</span>
                    <span class="badge bg-light text-dark border">🎨 @Model.Color</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted">Price:</span>
                    <span class="fw-bold text-success">@Model.Price.ToString("C")</span>
                </li>
            </ul>
            
            <p class="text-muted text-center small mb-0">
                <i class="bi bi-info-circle"></i> This action will unassign the yarn from Project #@Model.ProjectId.
            </p>
        </div>
        
        <div class="card-footer bg-transparent d-flex justify-content-between p-3">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Cancel, keep it
            </a>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash-fill"></i> Yes, Delete
                </button>
            </form>
        </div>
        
    </div>
</div>