@using Amigurumemi.Contracts.Messaging.Responses.Yarns
@model YarnGetResponse

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-basket-fill"></i> Yarn Inventory</h2>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Add New Yarn</a>
    </div>

    <form method="get" class="card p-3 bg-light mb-4 shadow-sm">
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label small fw-bold">Yarn Name</label>
                <input type="text" name="name" value="@Model.Filter?.Name" class="form-control" placeholder="e.g., Cotton Soft" />
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-bold">Brand</label>
                <input type="text" name="brand" value="@Model.Filter?.Brand" class="form-control" placeholder="e.g., Alize" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Brand</th>
                        <th>Color</th>
                        <th>Weight (g)</th>
                        <th>Price</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No yarns found in inventory.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><strong>@item.Name</strong></td>
                                <td>@item.Brand</td>
                                <td>
                                    <span class="badge bg-light text-dark border shadow-sm">🎨 @item.Color</span>
                                </td>
                                <td>@item.Weight g</td>
                                <td class="fw-bold text-success">@item.Price.ToString("C")</td>

                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Pager != null && Model.Pager.Count > Model.Pager.PageSize)
    {
        int totalPages = (int)Math.Ceiling((double)Model.Pager.Count / Model.Pager.PageSize);
        int currentPage = Model.Pager.Page;

        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-name="@Model.Filter?.Name"
                       asp-route-brand="@Model.Filter?.Brand">Previous</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-name="@Model.Filter?.Name"
                           asp-route-brand="@Model.Filter?.Brand">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-name="@Model.Filter?.Name"
                       asp-route-brand="@Model.Filter?.Brand">Next</a>
                </li>
            </ul>
            <div class="text-center text-muted small mt-2">
                Showing @Model.Items.Count of @Model.Pager.Count yarns
            </div>
        </nav>
    }
</div>