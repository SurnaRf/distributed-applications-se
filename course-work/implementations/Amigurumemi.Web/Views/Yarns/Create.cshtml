@using Amigurumemi.Contracts.Messaging.Requests.Yarns
@model YarnRequest

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4">Add New Yarn to Inventory</h2>

    <form method="post" class="card p-4 shadow-sm">
        
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Yarn Name / Model</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Jeans, Catona" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Brand" class="form-label">Brand</label>
            <input asp-for="Brand" class="form-control" placeholder="e.g. YarnArt, Scheepjes" />
            <span asp-validation-for="Brand" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Color" class="form-label">Color Code / Name</label>
            <input asp-for="Color" class="form-control" placeholder="e.g. Mint Green (No. 79)" />
            <span asp-validation-for="Color" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Weight" class="form-label">Weight (grams)</label>
                <input asp-for="Weight" type="number" step="0.1" class="form-control" placeholder="50" />
                <span asp-validation-for="Weight" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label">Price</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
            <button type="submit" class="btn btn-success px-4">Save Yarn</button>
        </div>

    </form>
</div>