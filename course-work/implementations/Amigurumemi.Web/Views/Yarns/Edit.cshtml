@using Amigurumemi.Contracts.Messaging.Requests.Yarns
@model YarnRequest

<div class="container mt-4" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Edit Yarn Details</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Inventory</a>
    </div>

    <form method="post" class="card p-4 shadow-sm">
        <input type="hidden" asp-for="ProjectId" />
        
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Yarn Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Brand" class="form-label">Brand</label>
            <input asp-for="Brand" class="form-control" />
            <span asp-validation-for="Brand" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Color" class="form-label">Color</label>
            <input asp-for="Color" class="form-control" />
            <span asp-validation-for="Color" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Weight" class="form-label">Weight (g)</label>
                <input asp-for="Weight" type="number" step="0.1" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label">Price</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
        </div>

    </form>
</div>