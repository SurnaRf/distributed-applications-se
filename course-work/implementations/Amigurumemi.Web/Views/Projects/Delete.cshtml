@using Amigurumemi.Contracts.Messaging.Responses.Projects
@model ProjectResponse

<div class="container mt-5" style="max-width: 500px;">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Project</h4>
        </div>
        <div class="card-body text-center py-4">
            <p class="fs-5">Are you sure you want to delete project:</p>
            <h3 class="text-danger mb-4">@Model.Name</h3>
            <p class="text-muted small">This action cannot be undone and all progress will be lost.</p>
        </div>
        <div class="card-footer bg-transparent d-flex justify-content-between p-3">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
            </form>
        </div>
    </div>
</div>