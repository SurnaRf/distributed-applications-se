@using Amigurumemi.Contracts.Messaging.Requests.Projects
@using Amigurumemi.Data.Entities
@using Amigurumemi.Contracts.Messaging.Responses.Yarns
@model ProjectRequest

<div class="container mt-4" style="max-width: 650px;">
    <h2 class="mb-4"><i class="bi bi-journal-plus"></i> Start New Project</h2>

    <form method="post" class="card p-4 shadow-sm">
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Project Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g., Pink Amigurumi Bunny" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PatternId" class="form-label">Select Pattern</label>
                <select asp-for="PatternId" class="form-select" asp-items="ViewBag.Patterns">
                    <option value="">-- Choose a Pattern --</option>
                </select>
                <span asp-validation-for="PatternId" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EstimatedCost" class="form-label">Estimated Cost ($)</label>
                <input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label">Initial Status</label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ProjectStatus>()"></select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Progress" class="form-label">Initial Progress (%)</label>
                <input asp-for="Progress" class="form-control" type="number" min="0" max="100" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="StartDate" class="form-label">Start Date</label>
            <input asp-for="StartDate" class="form-control" type="date" />
        </div>

        <div class="mb-3">
            <label class="form-label d-block fw-bold text-secondary">Select Yarns from Inventory:</label>
            <div class="card p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                @if (ViewBag.Yarns != null)
                {
                    foreach (var yarn in (IEnumerable<YarnResponse>)ViewBag.Yarns)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="selectedYarnIds" value="@yarn.Id" id="yarn_@yarn.Id">
                            <label class="form-check-label" for="yarn_@yarn.Id">
                                <strong>@yarn.Name</strong> (@yarn.Brand) - <span class="badge bg-white text-dark border">🎨 @yarn.Color</span>
                            </label>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No yarns available in inventory.</p>
                }
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Notes / Additional Details</label>
            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Notes about modifications, hook sizes..."></textarea>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsFavorite" class="form-check-input" type="checkbox" />
            <label asp-for="IsFavorite" class="form-check-label">Mark as Favorite ⭐</label>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
            <button type="submit" class="btn btn-success px-4">Create Project</button>
        </div>
    </form>
</div>