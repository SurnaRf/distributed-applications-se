@using Amigurumemi.Contracts.Messaging.Responses.Users
@model UsersGetResponse

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Registered Users Control Panel</h2>
    </div>

    <form method="get" class="card p-3 bg-light mb-4 shadow-sm">
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label small fw-bold">Username</label>
                <input type="text" name="username" value="@Model.Filter?.Username" class="form-control" placeholder="Search by username..." />
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-bold">Email Address</label>
                <input type="text" name="email" value="@Model.Filter?.Email" class="form-control" placeholder="Search by email..." />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Filter</button>
                <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>System Role</th>
                        <th>Registration Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No users found matching the criteria.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><strong>@@@item.Username</strong></td>
                                <td>@item.FirstName @item.LastName</td>
                                <td>@item.Email</td>
                                <td>
                                    @if (item.Role == "Admin")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-shield-lock"></i> @item.Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">@item.Role</span>
                                    }
                                </td>
                                <td>@item.RegistrationDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Pager != null && Model.Pager.Count > Model.Pager.PageSize)
    {
        int totalPages = (int)Math.Ceiling((double)Model.Pager.Count / Model.Pager.PageSize);
        int currentPage = Model.Pager.Page;

        <nav aria-label="User navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-username="@Model.Filter?.Username"
                       asp-route-email="@Model.Filter?.Email">Previous</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-username="@Model.Filter?.Username"
                           asp-route-email="@Model.Filter?.Email">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-username="@Model.Filter?.Username"
                       asp-route-email="@Model.Filter?.Email">Next</a>
                </li>
            </ul>
            <div class="text-center text-muted small mt-2">
                Showing @Model.Items.Count of @Model.Pager.Count users
            </div>
        </nav>
    }
</div>