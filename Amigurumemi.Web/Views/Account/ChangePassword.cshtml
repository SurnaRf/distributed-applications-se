@using Amigurumemi.Contracts.Messaging.Requests.Auth
@model ChangePasswordRequest

@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-warning">🔒 Change Password</h2>
                    <p class="text-muted">Ensure your account stays secure.</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label small fw-bold">Current Password</label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-bold">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 btn-lg rounded-pill shadow-sm mt-2 fw-bold text-dark">Update Password</button>
                </form>

                <div class="text-center mt-4">
                    <a asp-controller="Users" asp-action="MyProfile" class="text-decoration-none small text-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}